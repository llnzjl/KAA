# Copy to .env; never commit .env.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DEMO_ENABLED=true
# Optional: compatible HTTPS chat completions endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_FALLBACK_MODELS=
# Gemini OpenAI-compatible option:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
# AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# Optional: Brave Search API; server-side, official-domain allowlist
SEARCH_API_KEY=
# DATABASE_PATH=/absolute/path/to/kaa.sqlite3
